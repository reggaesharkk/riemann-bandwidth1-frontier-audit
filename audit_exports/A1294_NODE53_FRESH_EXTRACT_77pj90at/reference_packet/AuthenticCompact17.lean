  lo := fun i => match i.val with | 0 => (195/32) | 1 => (405/64) | 2 => (195/32) | 3 => (405/64) | _ => (195/32)
  hi := fun i => match i.val with | 0 => (405/64) | 1 => (105/16) | 2 => (405/64) | 3 => (105/16) | _ => (105/16)
def anchor : Fin 5 → ℚ := box.lo
